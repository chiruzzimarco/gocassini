# Hostname Traefik routes to the codec (needs a DNS record pointing here).
CODEC_HOST=codec.example.com
# Basic-auth users, htpasswd format: `openssl passwd -apr1 <password>`.
# Keep the single quotes: they stop compose from expanding the $ in the hash.
CODEC_AUTH_USERS='codec:$apr1$...'
# Owner of ./site on the host; the upload service writes files as this user.
CODEC_UID=1000
CODEC_GID=1000
